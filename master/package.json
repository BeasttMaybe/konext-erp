{
  "name": "konext-master",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema master do Konext: administra as lojas que usam o ERP. Ver README.md.",
  "scripts": {
    "gerar": "node scripts/gerar-cliente-central.mjs",
    "postinstall": "node scripts/gerar-cliente-central.mjs",
