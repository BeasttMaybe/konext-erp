# Copie para .env e preencha. Este arquivo NAO contem segredos.

# "teste" ou "producao". Usado por scripts/verificar-ambiente.mjs para classificar as
# conexoes abaixo e alertar sobre ambiente misto.
AMBIENTE=""
# Defina como "1" apenas quando souber que CENTRAL/CUNHADO continuam em producao
# enquanto DATABASE_URL/TENANT_PRINCIPAL_DATABASE_URL apontam para um banco de teste.
AMBIENTE_MISTO_CIENTE=""

# Banco do tenant usado pelo Prisma CLI (migrate/generate).
DATABASE_URL=""
# Banco central: usuarios, sessoes e registro de tenants.
CENTRAL_DATABASE_URL=""

# Um par por tenant. O banco central guarda apenas o NOME da variavel
# (connectionRef, padrao TENANT_<NOME>_DATABASE_URL), nunca a URL.
TENANT_PRINCIPAL_DATABASE_URL=""
TENANT_CUNHADO_DATABASE_URL=""

# Segredo usado para autenticar chamadas agendadas.
CRON_SECRET=""
