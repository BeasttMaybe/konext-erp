generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            String      @id @default(uuid())
  nome          String
  email         String      @unique
  senha         String
  fotoPerfilUrl String?
  role          RoleUsuario @default(ADMIN)
  logsAuditoria LogAuditoria[]
  ordensServicoExcluidas OrdemServico[] @relation("OrdemServicoExcluidaPor")
  ordensServicoCriadas OrdemServico[] @relation("OrdemServicoCriadaPor")
  ordensServicoTecnico TecnicoOS[] @relation("TecnicosDaOS")
  termosGarantiaCriados TermoGarantiaOS[] @relation("TermoGarantiaCriadoPor")
  retornosGarantiaCriados RetornoGarantiaOS[] @relation("RetornoGarantiaCriadoPor")
  metasCriadas Meta[] @relation("MetasCriadasPor")
  caixaSessionsAbertas CaixaSession[] @relation("CaixaSessionAbertaPor")
  contasReceberCriadas ContaReceber[] @relation("ContaReceberCriadaPor")
  despesasCriadas Despesa[] @relation("DespesaCriadaPor")
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
}

model LogAuditoria {
  id         String   @id @default(cuid())

  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  empresaId  String?

  acao       String
  entidade   String
  entidadeId String?

  dadosAntes Json?
  dadosDepois Json?

  motivo     String?
  origem     String?

  criadoEm   DateTime @default(now())

  @@index([usuarioId])
  @@index([empresaId])
  @@index([entidade])
  @@index([entidadeId])
  @@index([acao])
  @@index([criadoEm])
}

enum RoleUsuario {
  ADMIN
  OPERADOR
  TECNICO
}

enum ModeloImpressaoOS {
  A4
  TERMICA_80MM
}

model Configuracao {
  id                        String   @id @default(uuid())
  razaoSocial               String   @default("")
  nomeFantasia              String   @default("Konext")
  cnpj                      String   @default("")
  inscricaoEstadual         String   @default("")
  telefone                  String   @default("")
  cep                       String   @default("")
  logradouro                String   @default("")
  numero                    String   @default("")
  bairro                    String   @default("")
  cidade                    String   @default("")
  estado                    String   @default("")
  endereco                  String   @default("")
  logoUrl                   String?
  chavePix                  String?
  mensagemCupom             String?
  modeloImpressaoOSPadrao   ModeloImpressaoOS @default(A4)
  imprimirLogoTermica       Boolean           @default(true)
  mensagemRodapeImpressaoOS String?
  habilitarMargemAutomatica Boolean  @default(true)
  permitirVendaSemEstoque   Boolean  @default(false)
  permitirPagamentoMisto    Boolean  @default(true)
  permitirDescontoPDV       Boolean  @default(true)
  descontoMaximoPDVPercentual Decimal @default(0) @db.Decimal(5, 2)
  permitirVendaFiado        Boolean  @default(false)
  habilitarPix              Boolean  @default(true)
  habilitarDinheiro         Boolean  @default(true)
  habilitarCartaoDebito     Boolean  @default(true)
  habilitarCartaoCredito    Boolean  @default(true)
  habilitarBoleto           Boolean  @default(false)
  habilitarCrediario        Boolean  @default(false)
  taxaCartaoDebitoPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito1xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito2xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito3xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito4xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito5xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito6xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito7xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito8xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito9xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito10xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito11xPercentual Decimal @default(0) @db.Decimal(5, 2)
  taxaCartaoCredito12xPercentual Decimal @default(0) @db.Decimal(5, 2)
  prazoPadraoBoletoDias     Int      @default(7)
  prazoPadraoCrediarioDias  Int      @default(30)
  maxParcelasCartaoCredito  Int      @default(12)
  /**
   * Fase 1D-3: liga/desliga o fechamento automatico de caixa e o horario em
   * que ele deveria rodar ("HH:mm"). So a configuracao — o fechamento em si
   * ainda nao tem tarefa agendada que o execute (ver painel-pdv.tsx).
   */
  fechamentoAutomaticoCaixaAtivo    Boolean @default(false)
  fechamentoAutomaticoCaixaHorario  String  @default("23:59")
  prazoGarantiaPadraoDias   Int      @default(90)
  prazoMinimoGarantiaDias   Int      @default(1)
  prazoMaximoGarantiaDias   Int      @default(365)
  exigirGarantiaAntesEntrega Boolean @default(true)
  exigirItemParaGarantia    Boolean  @default(true)
  exigirItemParaEnviarPDV   Boolean  @default(true)
  exigirDiagnosticoParaFinalizar Boolean @default(false)
  permitirFinalizarSemPagamento Boolean @default(true)
  permitirGarantiaPersonalizada Boolean @default(true)
  textoCoberturaGarantia    String?
  textoExclusoesGarantia    String?
  textoResponsabilidadeDados String?
  /**
   * Fase 2A-1: fuso horário da loja, usado por lib/datas.ts pra resolver
   * TODA fronteira de dia/semana/mes/"agora" da aplicacao — nunca o fuso do
   * processo (Vercel roda em UTC). Cada tenant futuro pode ter o seu; ate
   * la, America/Sao_Paulo cobre o unico tenant hoje. Resolvido uma vez por
   * requisicao em lib/tenant/exigir-contexto-tenant.ts.
   */
  fusoHorario                String   @default("America/Sao_Paulo")
  criadoEm                  DateTime @default(now())
  atualizadoEm              DateTime @updatedAt
}

// ==========================================
// MÓDULO: CRM (Clientes)
// ==========================================
model Cliente {
  id                String           @id @default(uuid())
  tipoPessoa        TipoPessoa       @default(FISICA)
  papel             TipoPapel        @default(CLIENTE)
  nomeRazaoSocial   String
  nomeFantasia      String?
  documento         String           @unique // CPF ou CNPJ
  inscricaoEstadual String?
  email             String?
  telefone          String
  isWhatsapp        Boolean          @default(true)
  cep               String?
  logradouro        String?
  numero            String?
  bairro            String?
  cidade            String?
  estado            String?
  categoria         CategoriaCliente @default(CLIENTE_FINAL)
  observacoes       String?

  // Relações
  ordensServico OrdemServico[]
  contasReceber ContaReceber[]
  despesas      Despesa[]
  vendas        Venda[]
  pedidosVenda  PedidoVenda[]
  notasFiscais  NotaFiscal[]
  contas        Conta[]
  oportunidades Oportunidade[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum TipoPapel {
  CLIENTE
  FORNECEDOR
}

enum CategoriaCliente {
  CLIENTE_FINAL
  EMPRESA
  ORGAO_PUBLICO
}

// ==========================================
// MÓDULO: CRM (Funil de Vendas)
// ==========================================
model Oportunidade {
  id             String        @id @default(uuid())
  titulo         String
  valor          Decimal       @default(0)
  estagio        EstagioFunil  @default(PROSPECCAO)
  dataFechamento DateTime?

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId])
  @@index([estagio])
}

enum EstagioFunil {
  PROSPECCAO
  DIAGNOSTICO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum StatusPropostaComercial {
  RASCUNHO
  ENVIADA
  APROVADA
  REJEITADA
}

model PropostaComercial {
  id                  String                  @id @default(uuid())
  cliente             String
  aosCuidados         String?
  dataEmissao         DateTime
  validade            DateTime
  proximoContato      DateTime?
  equipamento         String?
  defeito             String?
  introducao          String?
  condicoesPagamento  String?
  termosGarantia      String?
  observacoesInternas String?
  subtotalBruto       Float
  descontoTotal       Float
  valorTotal          Float
  status              StatusPropostaComercial @default(RASCUNHO)
  criadoEm            DateTime                @default(now())
  atualizadoEm        DateTime                @updatedAt

  itens PropostaItem[]

  @@index([status])
  @@index([dataEmissao])
}

model PropostaItem {
  id                String            @id @default(uuid())
  propostaId        String
  proposta          PropostaComercial @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  descricao         String
  quantidade        Int
  precoUnitario     Float
  descontoPercentual Float
  subtotal          Float
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt

  @@index([propostaId])
}

// ==========================================
// MÓDULO: ORDEM DE SERVIÇO (OS)
// ==========================================
model OrdemServico {
  id       String @id @default(uuid())
  numeroOs Int    @unique @default(autoincrement())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  equipamento  String
  marca        String?
  modelo       String?
  imei         String?
  senha        String?
  senhaDesenho String? // Guarda os nos do padrao em string (ex: "1-2-5-8-9")

  relatoCliente  String
  condicaoFisica String?
  acessorios     String?

  status      StatusOS @default(AGUARDANDO_ORCAMENTO)
  etapa       EtapaOS  @default(ORCAMENTO)
  situacao    SituacaoOS?
  ehRetornoGarantia Boolean @default(false)
  osOrigemGarantiaId String?
  osOrigemGarantia OrdemServico? @relation("RetornosGarantiaOS", fields: [osOrigemGarantiaId], references: [id])
  retornosGarantia OrdemServico[] @relation("RetornosGarantiaOS")
  retornoGarantiaId String? @unique
  retornoGarantia RetornoGarantiaOS? @relation("RetornoGarantiaDaOS", fields: [retornoGarantiaId], references: [id])
  observacoes String?
  archivedAt  DateTime?
  entregueSemServico Boolean @default(false)
  motivoSemServico String?
  excluidaEm DateTime?
  excluidaPorId String?
  excluidaPor Usuario? @relation("OrdemServicoExcluidaPor", fields: [excluidaPorId], references: [id])
  motivoExclusao String?
  statusAnterior StatusOS?
  prazoGarantiaDias Int?

  /**
   * Quem registrou a OS — fonte da regra de visibilidade "OS que eu criei"
   * (Fase 1D-2, ver lib/auth/escopos.ts). Nulo em OS antigas (sem backfill,
   * mesma decisao de TecnicoOS abaixo): so fica visivel pra quem tem
   * os.ver_todas ou esta em TecnicoOS.
   */
  criadoPorId String?
  criadoPor   Usuario? @relation("OrdemServicoCriadaPor", fields: [criadoPorId], references: [id])

  itens      ItemOS[]
  transacoes ContaReceber[] // Vínculo com o financeiro
  termoGarantia TermoGarantiaOS?
  retornosGarantiaRegistros RetornoGarantiaOS[] @relation("RetornoGarantiaOsOrigem")
  tecnicos   TecnicoOS[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([excluidaEm])
  @@index([excluidaPorId])
  @@index([criadoPorId])
  @@index([ehRetornoGarantia])
  @@index([osOrigemGarantiaId])
  @@index([retornoGarantiaId])
  @@index([etapa])
}

/**
 * Tecnico(s) responsaveis por uma OS (Fase 1D-2). Uma OS pode ter mais de
 * um; exatamente um e `principal` quando ha pelo menos um tecnico. As
 * participacoes sempre somam 100% — regra pura e testada em
 * lib/dominio/os/tecnicos.ts, nunca reimplementada aqui nem na action.
 */
model TecnicoOS {
  id           String       @id @default(uuid())
  osId         String
  os           OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario      @relation("TecnicosDaOS", fields: [usuarioId], references: [id])
  participacaoPercentual Decimal @default(0) @db.Decimal(5, 2)
  principal    Boolean      @default(false)
  criadoEm     DateTime     @default(now())

  @@unique([osId, usuarioId])
  @@index([usuarioId])
}

model TermoGarantiaOS {
  id                 String       @id @default(uuid())
  osId               String       @unique
  os                 OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  prazoGarantiaDias  Int          @default(90)
  dataInicioGarantia DateTime
  dataFimGarantia    DateTime
  textoGarantia      String
  criadoPorId        String?
  criadoPor          Usuario?     @relation("TermoGarantiaCriadoPor", fields: [criadoPorId], references: [id])
  canceladaEm        DateTime?
  motivoCancelamento String?
  retornos           RetornoGarantiaOS[]
  criadoEm           DateTime     @default(now())
  atualizadoEm       DateTime     @updatedAt

  @@index([dataFimGarantia])
  @@index([dataInicioGarantia])
  @@index([criadoEm])
  @@index([canceladaEm])
}

model RetornoGarantiaOS {
  id             String                   @id @default(uuid())
  termoGarantiaId String
  termoGarantia  TermoGarantiaOS         @relation(fields: [termoGarantiaId], references: [id], onDelete: Cascade)
  osOrigemId     String?
  osOrigem       OrdemServico?            @relation("RetornoGarantiaOsOrigem", fields: [osOrigemId], references: [id], onDelete: SetNull)
  osRetornoId    String?                  @unique
  osRetorno      OrdemServico?            @relation("RetornoGarantiaDaOS")
  motivo         String
  descricao      String
  analiseTecnica String?
  resultado      ResultadoRetornoGarantia @default(EM_ANALISE)
  descricaoServico String?
  pecasAdicionais String?
  houveTroca     Boolean                  @default(false)
  houveCobranca  Boolean                  @default(false)
  valorAdicional Decimal?
  observacoesTecnicas String?
  finalizadoEm   DateTime?
  finalizadoPorId String?
  criadoPorId    String?
  criadoPor      Usuario?                 @relation("RetornoGarantiaCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm       DateTime                 @default(now())
  atualizadoEm   DateTime                 @default(now()) @updatedAt

  @@index([termoGarantiaId])
  @@index([osOrigemId])
  @@index([osRetornoId])
  @@index([criadoEm])
  @@index([finalizadoEm])
}

enum ResultadoRetornoGarantia {
  PROCEDENTE
  IMPROCEDENTE
  SEM_GARANTIA
  RESOLVIDO_SEM_TROCA
  TROCA_REALIZADA
  COBRANCA_ADICIONAL
  EM_ANALISE
}

model ItemOS {
  id           String       @id @default(uuid())
  osId         String
  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  descricao    String
  tipoPeca     TipoPeca
  custoPeca    Float
  valorCobrado Float
  criadoEm     DateTime @default(now())
}

enum StatusOS {
  AGUARDANDO_ORCAMENTO
  AGUARDANDO_APROVACAO
  APROVADO
  AGUARDANDO_PECA
  EM_MANUTENCAO
  GARANTIA_RETORNO
  PRONTO
  ENTREGUE
}

/**
 * Fase 1C-3: as quatro etapas do fluxo de OS, substituindo os oito valores de
 * StatusOS como fonte de leitura da aplicacao. `status` continua sendo
 * escrito (escrita dupla) ate a fase de contrato remover a coluna — ver
 * docs/operacao/migrations.md e lib/dominio/os/etapas.ts.
 */
enum EtapaOS {
  ORCAMENTO
  CONSERTO
  PRONTO
  ENTREGUE
}

/** Situacao independente da etapa — nunca implica mudanca de etapa por si so. */
enum SituacaoOS {
  AGUARDANDO_APROVACAO
  AGUARDANDO_PECA
}

enum TipoPeca {
  TELA
  BATERIA
  CONECTOR_CARGA
  TAMPA_IPHONE
  TAMPA_ANDROID
  OUTROS
}

// ==========================================
// MÓDULO: FINANCEIRO (Contas a Receber)
// ==========================================
model ContaReceber {
  id        String @id @default(uuid())
  descricao String @default("")
  valor     Float
  observacaoLancamento String?
  observacaoPagamento  String?

  parcelamentoId String?
  numeroParcela  Int     @default(1)
  totalParcelas  Int     @default(1)

  dataInicio      DateTime?
  dataFinalizacao DateTime?

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  pedidoId String?
  pedido   PedidoVenda? @relation(fields: [pedidoId], references: [id])

  ordemServicoId String?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id])

  vendaId String?
  venda   Venda?  @relation(fields: [vendaId], references: [id])

  vendaPagamentoId String? @unique
  vendaPagamento   VendaPagamento? @relation(fields: [vendaPagamentoId], references: [id])

  dataVencimento  DateTime
  dataRecebimento DateTime?

  status           StatusPagamento @default(PENDENTE)
  formaPagamento   FormaPagamento?
  formaRecebimento FormaPagamento
  origem           OrigemReceita

  notaFiscalEmitida Boolean @default(false)

  /** Quem lancou a conta — fonte de "financeiro.ver" sem "_todos" (Fase 1D-2, ver lib/auth/escopos.ts). Nulo em lancamentos antigos, sem backfill. */
  criadoPorId String?
  criadoPor   Usuario? @relation("ContaReceberCriadaPor", fields: [criadoPorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([parcelamentoId])
  @@index([pedidoId])
  @@index([vendaId])
  @@index([criadoPorId])
}

enum StatusPagamento {
  PENDENTE
  PAGO
  RECEBIDO
  ATRASADO
  RENEGOCIADO
}

enum FormaPagamento {
  PIX
  TED
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_CREDITO_AVISTA
  CARTAO_CREDITO_PARCELADO
  CARTAO_DEBITO
  BOLETO
  CREDIARIO
  EMPENHO_PUBLICO
}

enum OrigemReceita {
  VENDA_PDV
  ORDEM_SERVICO
  CONTRATO_RECORRENTE
  LICITACAO
  AVULSO
}

// ==========================================
// MÓDULO: CONTAS A PAGAR
// ==========================================
model Despesa {
  id           String      @id @default(uuid())
  fornecedor   String
  descricao    String
  valorTotal   Float
  tipo         TipoDespesa
  qtdParcelas  Int

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  /** Quem lancou a despesa — mesma regra de visibilidade de ContaReceber (Fase 1D-2). Nulo em despesas antigas, sem backfill. */
  criadoPorId String?
  criadoPor   Usuario? @relation("DespesaCriadaPor", fields: [criadoPorId], references: [id])

  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  parcelas ParcelaDespesa[]

  @@index([criadoPorId])
}

model ParcelaDespesa {
  id             String               @id @default(uuid())
  despesaId      String
  despesa        Despesa              @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  numeroParcela  Int
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusParcelaDespesa @default(PENDENTE)
  valorPago      Float?
  criadoEm       DateTime             @default(now())
}

enum TipoDespesa {
  UNICA
  PARCELADA
  FIXA_MENSAL
}

enum StatusParcelaDespesa {
  PENDENTE
  PAGO
  ATRASADO
}

// ==========================================
// MÓDULO: NOTAS FISCAIS
// ==========================================
model NotaFiscal {
  id          String           @id @default(uuid())
  numero      String
  chaveAcesso String?
  valorTotal  Float
  status      StatusNotaFiscal @default(PENDENTE)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  criadoEm DateTime @default(now())
}

enum StatusNotaFiscal {
  EMITIDA
  CANCELADA
  PENDENTE
}

// ==========================================
// MÓDULO: ESTOQUE E PRODUTOS
// ==========================================
model Produto {
  id           String  @id @default(uuid())
  codigoBarras String? @unique
  imagemUrl    String?
  nome         String
  descricao    String?

  categoria CategoriaProduto

  itensVenda ItemVenda[]
  pedidoVendaItens PedidoVendaItem[]

  custo      Float // Preço de compra do fornecedor
  precoVenda Float // Preço final para o cliente

  quantidadeEstoque Int @default(0)
  estoqueMinimo     Int @default(3) // Alerta quando estiver acabando

  ativo Boolean @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ==========================================
// MÓDULO: CONTAS UNIFICADAS (Receber e Pagar)
// ==========================================
enum TipoCliente {
  CLIENTE_FINAL
  EMPRESA
  ORGAO_PUBLICO
}

model Conta {
  id          String   @id @default(cuid())
  descricao   String
  valor       Float
  vencimento  DateTime
  status      String   // PAGO, PENDENTE, ATRASADO
  tipo        String   // RECEBER ou PAGAR
  
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum CategoriaProduto {
  ACESSORIO // Cabos, Capas, Películas (quando aplicável)
  PECA_REPARO // Telas, Baterias, Conectores
  EQUIPAMENTO_REDE // Switches, Roteadores (para B2B/Licitações)
  SERVICO // Mão de obra (não movimenta estoque físico)
  OUTROS
}

// ==========================================
// MÓDULO: VENDAS (PDV)
// ==========================================
enum StatusPedido {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

enum OrigemPedido {
  VENDAS
  PDV
}

model PedidoVenda {
  id String @id @default(uuid())

  numeroPedido Int @unique @default(autoincrement())
  status       StatusPedido @default(PENDENTE)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  vendaId String? @unique
  venda   Venda?  @relation(fields: [vendaId], references: [id])

  vendedor       String
  total          Float
  origem         OrigemPedido    @default(VENDAS)
  formaPagamento FormaPagamento?
  dataCriacao    DateTime @default(now())

  itens         PedidoVendaItem[]
  parcelas      PedidoVendaParcela[]
  contasReceber ContaReceber[]

  @@index([clienteId])
  @@index([status])
  @@index([origem])
  @@index([dataCriacao])
}

model PedidoVendaItem {
  id String @id @default(uuid())

  pedidoId String
  pedido   PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  nome                 String
  quantidade           Int
  precoUnitario        Float
  descontoPorcentagem  Float @default(0)
  subtotal             Float

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([pedidoId])
  @@index([produtoId])
}

model PedidoVendaParcela {
  id String @id @default(uuid())

  pedidoId String
  pedido   PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  valor          Float
  dataVencimento DateTime

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([pedidoId])
  @@index([dataVencimento])
}

model Venda {
  id        String   @id @default(uuid())
  clienteId String? // Opcional para venda rápida de balcão
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  itens ItemVenda[]
  pagamentos VendaPagamento[]
  pedidoVenda PedidoVenda?

  // Ligacao com o financeiro (suporta multiplas contas por venda)
  contasReceber ContaReceber[]

  formaPagamento FormaPagamento
  valorTotal     Float
  desconto       Float          @default(0)

  criadoEm       DateTime      @default(now())
  caixaSession   CaixaSession? @relation(fields: [caixaSessionId], references: [id])
  caixaSessionId String?
}

model VendaPagamento {
  id             String         @id @default(uuid())
  vendaId        String
  venda          Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  formaPagamento FormaPagamento
  valorBruto     Float
  percentualTaxa Float          @default(0)
  valorTaxa      Float          @default(0)
  valorLiquido   Float
  parcelas       Int            @default(1)
  diasVencimento Int?
  dataVencimento DateTime?

  contaReceber   ContaReceber?

  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  @@index([vendaId])
  @@index([formaPagamento])
  @@index([dataVencimento])
  @@index([criadoEm])
}

model ItemVenda {
  id      String @id @default(uuid())
  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  descricao String @default("")

  quantidade    Int
  custoUnitario Float @default(0)
  precoUnitario Float
  subtotal      Float
}

// ==========================================
// MÓDULO: CONTROLE DE FLUXO DE CAIXA
// ==========================================
model CaixaSession {
  id String @id @default(uuid())

  status CaixaStatus @default(ABERTO)

  valorAbertura   Float // Saldo inicial/troco
  valorFechamento Float? // Saldo final conferido

  dataAbertura   DateTime  @default(now())
  dataFechamento DateTime?

  vendas Venda[] // Vincula as vendas feitas nesta sessão

  /** Quem abriu o caixa — fonte de "caixa.ver" sem "_todos" (Fase 1D-2, ver lib/auth/escopos.ts). Nulo em sessoes antigas, sem backfill. */
  abertoPorId String?
  abertoPor   Usuario? @relation("CaixaSessionAbertaPor", fields: [abertoPorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([abertoPorId])
}

enum CaixaStatus {
  ABERTO
  FECHADO
}

// ==========================================
// MÓDULO: NOTIFICAÇÕES
// ==========================================
model Notificacao {
  id       String @id @default(cuid())
  titulo   String
  mensagem String
  lida     Boolean  @default(false)
  criadoEm DateTime @default(now())
}

// ==========================================
// MÓDULO: METAS
// ==========================================
model Meta {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String?
  categoria   CategoriaMeta
  tipoValor   TipoValorMeta
  origemProgresso OrigemProgressoMeta @default(MANUAL)
  fonteAutomatica FonteAutomaticaMeta?
  metricaAutomatica MetricaAutomaticaMeta?
  configuracaoAutomatica Json?
  direcao     DirecaoMeta   @default(MAIOR_MELHOR)
  valorAlvo   Float?
  valorAtual  Float          @default(0)
  unidade     String?
  dataInicio  DateTime?
  dataPrazo   DateTime?
  ultimaSincronizacaoEm DateTime?
  erroSincronizacao String?
  prioridade  PrioridadeMeta @default(MEDIA)
  status      StatusMeta     @default(EM_ANDAMENTO)

  criadoPorId String?
  criadoPor   Usuario?       @relation("MetasCriadasPor", fields: [criadoPorId], references: [id])

  excluidaEm    DateTime?
  excluidaPorId String?
  concluidaEm   DateTime?
  canceladaEm   DateTime?

  itensChecklist ItemChecklistMeta[]
  historicos     HistoricoMeta[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@index([categoria])
  @@index([prioridade])
  @@index([dataPrazo])
  @@index([criadoEm])
  @@index([excluidaEm])
  @@index([origemProgresso])
  @@index([fonteAutomatica])
  @@index([metricaAutomatica])
  @@index([ultimaSincronizacaoEm])
}

model ItemChecklistMeta {
  id      String @id @default(uuid())
  metaId  String
  meta    Meta   @relation(fields: [metaId], references: [id], onDelete: Cascade)
  titulo  String
  concluido    Boolean  @default(false)
  ordem        Int      @default(0)
  concluidoEm  DateTime?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([metaId])
}

model HistoricoMeta {
  id             String            @id @default(uuid())
  metaId         String
  meta           Meta              @relation(fields: [metaId], references: [id], onDelete: Cascade)
  tipo           TipoHistoricoMeta
  descricao      String
  valorAnterior  Float?
  valorNovo      Float?
  criadoPorId    String?
  criadoEm       DateTime          @default(now())

  @@index([metaId])
  @@index([tipo])
  @@index([criadoEm])
}

enum CategoriaMeta {
  FINANCEIRA
  OPERACIONAL
  COMERCIAL
  ESTOQUE
  ESTRUTURAL
  EQUIPAMENTO
  REFORMA
  OUTRA
}

enum TipoValorMeta {
  DINHEIRO
  QUANTIDADE
  PERCENTUAL
  CHECKLIST
}

enum OrigemProgressoMeta {
  MANUAL
  AUTOMATICA
}

enum DirecaoMeta {
  MAIOR_MELHOR
  MENOR_MELHOR
}

enum FonteAutomaticaMeta {
  ORDENS_SERVICO
  FINANCEIRO
  PDV
  VENDAS
  ESTOQUE
  GARANTIAS
}

enum MetricaAutomaticaMeta {
  FATURAMENTO_OS
  QUANTIDADE_OS_FINALIZADAS
  QUANTIDADE_OS_CRIADAS
  TICKET_MEDIO_OS
  TAXA_RETORNO_GARANTIA
  GARANTIAS_ATIVAS
  RETORNOS_GARANTIA
  FATURAMENTO_PDV
  QUANTIDADE_VENDAS
  RECEBIMENTOS_FINANCEIRO
  DESPESAS_FINANCEIRO
  QUANTIDADE_ITEM_ESTOQUE
}

enum PrioridadeMeta {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusMeta {
  EM_ANDAMENTO
  ATENCAO
  ATRASADA
  CONCLUIDA
  PAUSADA
  CANCELADA
}

enum TipoHistoricoMeta {
  CRIACAO
  ATUALIZACAO_PROGRESSO
  ALTERACAO_STATUS
  ALTERACAO_PRAZO
  ALTERACAO_CHECKLIST
  SINCRONIZACAO_AUTOMATICA
  CONCLUSAO
  PAUSA
  CANCELAMENTO
  OBSERVACAO
}
