generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            String      @id @default(uuid())
  nome          String
  email         String      @unique
  senha         String
  fotoPerfilUrl String?
  role          RoleUsuario @default(ADMIN)
  logsAuditoria LogAuditoria[]
  ordensServicoExcluidas OrdemServico[] @relation("OrdemServicoExcluidaPor")
  ordensServicoCriadas OrdemServico[] @relation("OrdemServicoCriadaPor")
  ordensServicoTecnico TecnicoOS[] @relation("TecnicosDaOS")
  termosGarantiaCriados TermoGarantiaOS[] @relation("TermoGarantiaCriadoPor")
  retornosGarantiaCriados RetornoGarantiaOS[] @relation("RetornoGarantiaCriadoPor")
  metasCriadas Meta[] @relation("MetasCriadasPor")
  caixaSessionsAbertas CaixaSession[] @relation("CaixaSessionAbertaPor")
  contasReceberCriadas ContaReceber[] @relation("ContaReceberCriadaPor")
  despesasCriadas Despesa[] @relation("DespesaCriadaPor")
  fotosOSEnviadas FotoOS[] @relation("FotoOSEnviadaPor")
  tokensFotoOSCriados TokenFotoOS[] @relation("TokenFotoOSCriadoPor")
  criadoEm      DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime    @updatedAt @db.Timestamptz(3)
}

model LogAuditoria {
  id         String   @id @default(cuid())

  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  empresaId  String?

  acao       String
  entidade   String
  entidadeId String?

  dadosAntes Json?
  dadosDepois Json?

  motivo     String?
  origem     String?

  criadoEm   DateTime @default(now()) @db.Timestamptz(3)

  @@index([usuarioId])
  @@index([empresaId])
  @@index([entidade])
  @@index([entidadeId])
  @@index([acao])
  @@index([criadoEm])
}

enum RoleUsuario {
  ADMIN
  OPERADOR
  TECNICO
}

enum ModeloImpressaoOS {
  A4
  TERMICA_80MM
}

model Configuracao {
  id                        String   @id @default(uuid())
  razaoSocial               String   @default("")
  nomeFantasia              String   @default("Konext")
  cnpj                      String   @default("")
  inscricaoEstadual         String   @default("")
  telefone                  String   @default("")
  cep                       String   @default("")
  logradouro                String   @default("")
  numero                    String   @default("")
  bairro                    String   @default("")
  cidade                    String   @default("")
  estado                    String   @default("")
  endereco                  String   @default("")
  logoUrl                   String?
  chavePix                  String?
  mensagemCupom             String?
  modeloImpressaoOSPadrao   ModeloImpressaoOS @default(A4)
  imprimirLogoTermica       Boolean           @default(true)
  mensagemRodapeImpressaoOS String?
  habilitarMargemAutomatica Boolean  @default(true)
  permitirVendaSemEstoque   Boolean  @default(false)
  permitirPagamentoMisto    Boolean  @default(true)
  permitirDescontoPDV       Boolean  @default(true)
  descontoMaximoPDVPercentual Decimal @default(0) @db.Decimal(7, 4)
  permitirVendaFiado        Boolean  @default(false)
  habilitarPix              Boolean  @default(true)
  habilitarDinheiro         Boolean  @default(true)
  habilitarCartaoDebito     Boolean  @default(true)
  habilitarCartaoCredito    Boolean  @default(true)
  habilitarBoleto           Boolean  @default(false)
  habilitarCrediario        Boolean  @default(false)
  taxaCartaoDebitoPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito1xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito2xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito3xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito4xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito5xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito6xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito7xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito8xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito9xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito10xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito11xPercentual Decimal @default(0) @db.Decimal(7, 4)
  taxaCartaoCredito12xPercentual Decimal @default(0) @db.Decimal(7, 4)
  prazoPadraoBoletoDias     Int      @default(7)
  prazoPadraoCrediarioDias  Int      @default(30)
  maxParcelasCartaoCredito  Int      @default(12)
  /**
   * Fase 1D-3: liga/desliga o fechamento automatico de caixa e o horario em
   * que ele deveria rodar ("HH:mm"). So a configuracao — o fechamento em si
   * ainda nao tem tarefa agendada que o execute (ver painel-pdv.tsx).
   */
  fechamentoAutomaticoCaixaAtivo    Boolean @default(false)
  fechamentoAutomaticoCaixaHorario  String  @default("23:59")
  prazoGarantiaPadraoDias   Int      @default(90)
  prazoMinimoGarantiaDias   Int      @default(1)
  prazoMaximoGarantiaDias   Int      @default(365)
  exigirGarantiaAntesEntrega Boolean @default(true)
  exigirItemParaGarantia    Boolean  @default(true)
  exigirItemParaEnviarPDV   Boolean  @default(true)
  exigirDiagnosticoParaFinalizar Boolean @default(false)
  /**
   * Peca de conserto costuma ser comprada e paga no ato, por servico. Com isto
   * ligado (padrao), o custo lancado na OS entra no financeiro como despesa JA
   * QUITADA: continua contando em relatorio, fluxo de caixa e apuracao de lucro,
   * mas nao vira conta em aberto esperando baixa manual de algo que ja foi pago.
   * Desligado, volta a nascer como parcela PENDENTE vencendo no dia — o caso de
   * quem compra peca faturada.
   */
  custoPecaOSJaPago         Boolean  @default(true)
  permitirFinalizarSemPagamento Boolean @default(true)
  permitirGarantiaPersonalizada Boolean @default(true)
  textoCoberturaGarantia    String?
  textoExclusoesGarantia    String?
  textoResponsabilidadeDados String?
  /**
   * Fase 2A-1: fuso horário da loja, usado por lib/datas.ts pra resolver
   * TODA fronteira de dia/semana/mes/"agora" da aplicacao — nunca o fuso do
   * processo (Vercel roda em UTC). Cada tenant futuro pode ter o seu; ate
   * la, America/Sao_Paulo cobre o unico tenant hoje. Resolvido uma vez por
   * requisicao em lib/tenant/exigir-contexto-tenant.ts.
   */
  fusoHorario                String   @default("America/Sao_Paulo")

  /**
   * Para onde vao os avisos de vencimento no Telegram.
   *
   * O token do bot e segredo de ambiente (TELEGRAM_BOT_TOKEN) e e UM so, da
   * Konext. O DESTINO e por loja: cada dono conversa com o mesmo bot e recebe
   * so os avisos dele. O chat id nao e segredo — e um identificador, como um
   * numero de telefone numa agenda —, por isso mora aqui e e colado pelo
   * proprio dono na tela de Configuracoes.
   *
   * Nulo ou vazio = loja sem aviso no Telegram. O aviso dentro do sistema
   * (o sininho) continua funcionando de qualquer forma.
   */
  telegramChatId            String?
  /** Desliga o aviso no Telegram sem apagar o chat id configurado. */
  avisarVencimentoNoTelegram Boolean @default(true)

  criadoEm                  DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm              DateTime @updatedAt @db.Timestamptz(3)
}

/**
 * Qual aviso de vencimento ja saiu.
 *
 * Existe por uma razao so: nao avisar duas vezes. Cron roda duas vezes —
 * redeploy, retry da plataforma, alguem abrindo a URL — e o unique abaixo e o
 * que garante que o aviso de hoje sai uma vez, no banco, nao na memoria de
 * quem executa.
 *
 * A chave e (tipo, conta, dias): a mesma conta e avisada quatro vezes, uma
 * por marco (3, 2, 1 e 0 dias), e cada marco uma unica vez. `contaId` nao e
 * chave estrangeira de proposito — ele aponta pra ParcelaDespesa OU pra
 * ContaReceber conforme o `tipo`, e as duas tabelas tem ids independentes.
 */
model AvisoDeVencimentoEnviado {
  id String @id @default(uuid())

  /// "PAGAR" (ParcelaDespesa) ou "RECEBER" (ContaReceber).
  tipo              TipoDeContaAvisada
  contaId           String
  /// 3, 2, 1 ou 0 — qual dos quatro marcos este registro representa.
  diasDeAntecedencia Int

  enviadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tipo, contaId, diasDeAntecedencia])
  @@index([enviadoEm])
}

enum TipoDeContaAvisada {
  PAGAR
  RECEBER
}

/// A conexao desta loja com o Bling. Uma linha so, como `Configuracao`.
///
/// A Konext LE do Bling e nunca escreve: o dono continua emitindo a nota la,
/// onde ja esta o motor fiscal e a contabilidade dele, e aqui as notas
/// aparecem para consulta e para alimentar o financeiro. Os escopos pedidos
/// no cadastro do aplicativo sao so de leitura, e isso nao e detalhe: e o que
/// garante que um bug deste lado nao emite, cancela nem da baixa em nada.
model IntegracaoBling {
  id String @id @default(uuid())

  /// Vale ~6h. Renovado sozinho antes de expirar.
  accessToken  String
  /// ROTACIONA A CADA USO: o Bling devolve um novo e invalida o anterior.
  refreshToken String
  expiraEm     DateTime @db.Timestamptz(3)

  /// Trava da renovacao, pelo relogio.
  ///
  /// Como o refresh token rotaciona, duas renovacoes simultaneas se matam: a
  /// segunda chega com um token que a primeira ja invalidou, e a conexao cai
  /// de vez — o dono teria que reconectar a mao, sem entender por que. Dois
  /// requests paralelos chegando com o token vencido e o caso normal, nao o
  /// raro.
  ///
  /// Guardar o INSTANTE em vez de um booleano e o que permite destravar
  /// sozinho: um processo que morreu no meio da renovacao deixaria a trava
  /// presa para sempre.
  renovandoDesde DateTime? @db.Timestamptz(3)

  /// Nonce do fluxo de autorizacao, de uso unico. Ver a rota de callback.
  estadoPendente   String?
  estadoPendenteEm DateTime? @db.Timestamptz(3)

  conectadoEm           DateTime  @default(now()) @db.Timestamptz(3)
  conectadoPor          String?
  ultimaSincronizacaoEm DateTime? @db.Timestamptz(3)
  /// Ultima falha, para a tela poder dizer o que houve em vez de so "erro".
  ultimoErro            String?

  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)
}

// ==========================================
// MÓDULO: CRM (Clientes)
// ==========================================
model Cliente {
  id                String           @id @default(uuid())
  tipoPessoa        TipoPessoa       @default(FISICA)
  papel             TipoPapel        @default(CLIENTE)
  nomeRazaoSocial   String
  nomeFantasia      String?
  documento         String           @unique // CPF ou CNPJ
  inscricaoEstadual String?
  email             String?
  telefone          String
  isWhatsapp        Boolean          @default(true)
  cep               String?
  logradouro        String?
  numero            String?
  bairro            String?
  cidade            String?
  estado            String?
  categoria         CategoriaCliente @default(CLIENTE_FINAL)
  observacoes       String?

  // Relações
  ordensServico OrdemServico[]
  contasReceber ContaReceber[]
  despesas      Despesa[]
  vendas        Venda[]
  pedidosVenda  PedidoVenda[]
  notasFiscais  NotaFiscal[]
  contas        Conta[]
  oportunidades Oportunidade[]

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum TipoPapel {
  CLIENTE
  FORNECEDOR
}

enum CategoriaCliente {
  CLIENTE_FINAL
  EMPRESA
  ORGAO_PUBLICO
}

// ==========================================
// MÓDULO: CRM (Funil de Vendas)
// ==========================================
model Oportunidade {
  id             String        @id @default(uuid())
  titulo         String
  valor          Decimal       @default(0) @db.Decimal(12, 2)
  estagio        EstagioFunil  @default(PROSPECCAO)
  dataFechamento DateTime?

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([clienteId])
  @@index([estagio])
}

enum EstagioFunil {
  PROSPECCAO
  DIAGNOSTICO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum StatusPropostaComercial {
  RASCUNHO
  ENVIADA
  APROVADA
  REJEITADA
}

model PropostaComercial {
  id                  String                  @id @default(uuid())
  cliente             String
  aosCuidados         String?
  dataEmissao         DateTime
  validade            DateTime
  proximoContato      DateTime?
  equipamento         String?
  defeito             String?
  introducao          String?
  condicoesPagamento  String?
  termosGarantia      String?
  observacoesInternas String?
  subtotalBruto       Decimal                 @db.Decimal(12, 2)
  descontoTotal       Decimal                 @db.Decimal(12, 2)
  valorTotal          Decimal                 @db.Decimal(12, 2)
  status              StatusPropostaComercial @default(RASCUNHO)
  /// Quando o cliente respondeu (aprovou ou recusou). Antes disso, `null`.
  /// Separado de `atualizadoEm` porque esse muda a cada edição de texto, e a
  /// data da resposta é o que mede quanto tempo o cliente leva pra decidir.
  respondidaEm        DateTime?               @db.Timestamptz(3)
  /// O que o cliente disse ao recusar (ou ao aprovar, se houver o que anotar).
  /// Orçamento recusado por preço e por prazo pedem reações diferentes, e sem
  /// isso toda recusa fica igual no histórico.
  motivoResposta      String?
  enviadaEm           DateTime?               @db.Timestamptz(3)
  criadoEm            DateTime                @default(now()) @db.Timestamptz(3)
  atualizadoEm        DateTime                @updatedAt @db.Timestamptz(3)

  itens PropostaItem[]

  @@index([status])
  @@index([dataEmissao])
  // A lista ordena e filtra por validade (vencendo/vencida), e o filtro de
  // "em aberto" sempre vem junto com o status.
  @@index([status, validade])
}

model PropostaItem {
  id                String            @id @default(uuid())
  propostaId        String
  proposta          PropostaComercial @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  descricao         String
  quantidade        Int
  precoUnitario     Decimal           @db.Decimal(12, 2)
  descontoPercentual Decimal          @db.Decimal(7, 4)
  subtotal          Decimal           @db.Decimal(12, 2)
  criadoEm          DateTime          @default(now()) @db.Timestamptz(3)
  atualizadoEm      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([propostaId])
}

// ==========================================
// MÓDULO: ORDEM DE SERVIÇO (OS)
// ==========================================
model OrdemServico {
  id       String @id @default(uuid())
  numeroOs Int    @unique @default(autoincrement())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  equipamento  String
  marca        String?
  modelo       String?
  imei         String?
  senha        String?
  senhaDesenho String? // Guarda os nos do padrao em string (ex: "1-2-5-8-9")

  relatoCliente  String
  condicaoFisica String?
  acessorios     String?

  status      StatusOS @default(AGUARDANDO_ORCAMENTO)
  etapa       EtapaOS  @default(ORCAMENTO)
  situacao    SituacaoOS?
  ehRetornoGarantia Boolean @default(false)
  osOrigemGarantiaId String?
  osOrigemGarantia OrdemServico? @relation("RetornosGarantiaOS", fields: [osOrigemGarantiaId], references: [id])
  retornosGarantia OrdemServico[] @relation("RetornosGarantiaOS")
  retornoGarantiaId String? @unique
  retornoGarantia RetornoGarantiaOS? @relation("RetornoGarantiaDaOS", fields: [retornoGarantiaId], references: [id])
  observacoes String?
  archivedAt  DateTime? @db.Timestamptz(3)
  entregueSemServico Boolean @default(false)
  motivoSemServico String?
  excluidaEm DateTime? @db.Timestamptz(3)
  excluidaPorId String?
  excluidaPor Usuario? @relation("OrdemServicoExcluidaPor", fields: [excluidaPorId], references: [id])
  motivoExclusao String?
  statusAnterior StatusOS?
  prazoGarantiaDias Int?

  /**
   * Quem registrou a OS — fonte da regra de visibilidade "OS que eu criei"
   * (Fase 1D-2, ver lib/auth/escopos.ts). Nulo em OS antigas (sem backfill,
   * mesma decisao de TecnicoOS abaixo): so fica visivel pra quem tem
   * os.ver_todas ou esta em TecnicoOS.
   */
  criadoPorId String?
  criadoPor   Usuario? @relation("OrdemServicoCriadaPor", fields: [criadoPorId], references: [id])

  itens      ItemOS[]
  transacoes ContaReceber[] // Vínculo com o financeiro
  termoGarantia TermoGarantiaOS?
  retornosGarantiaRegistros RetornoGarantiaOS[] @relation("RetornoGarantiaOsOrigem")
  tecnicos   TecnicoOS[]
  fotos      FotoOS[]
  tokensDeFoto TokenFotoOS[]

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([excluidaEm])
  @@index([excluidaPorId])
  @@index([criadoPorId])
  @@index([ehRetornoGarantia])
  @@index([osOrigemGarantiaId])
  @@index([retornoGarantiaId])
  @@index([etapa])
}

/**
 * Tecnico(s) responsaveis por uma OS (Fase 1D-2). Uma OS pode ter mais de
 * um; exatamente um e `principal` quando ha pelo menos um tecnico. As
 * participacoes sempre somam 100% — regra pura e testada em
 * lib/dominio/os/tecnicos.ts, nunca reimplementada aqui nem na action.
 */
model TecnicoOS {
  id           String       @id @default(uuid())
  osId         String
  os           OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario      @relation("TecnicosDaOS", fields: [usuarioId], references: [id])
  participacaoPercentual Decimal @default(0) @db.Decimal(7, 4)
  principal    Boolean      @default(false)
  criadoEm     DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([osId, usuarioId])
  @@index([usuarioId])
}

model TermoGarantiaOS {
  id                 String       @id @default(uuid())
  osId               String       @unique
  os                 OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  prazoGarantiaDias  Int          @default(90)
  dataInicioGarantia DateTime @db.Timestamptz(3)
  dataFimGarantia    DateTime @db.Timestamptz(3)
  textoGarantia      String
  criadoPorId        String?
  criadoPor          Usuario?     @relation("TermoGarantiaCriadoPor", fields: [criadoPorId], references: [id])
  canceladaEm        DateTime? @db.Timestamptz(3)
  motivoCancelamento String?
  retornos           RetornoGarantiaOS[]
  criadoEm           DateTime     @default(now()) @db.Timestamptz(3)
  atualizadoEm       DateTime     @updatedAt @db.Timestamptz(3)

  @@index([dataFimGarantia])
  @@index([dataInicioGarantia])
  @@index([criadoEm])
  @@index([canceladaEm])
}

model RetornoGarantiaOS {
  id             String                   @id @default(uuid())
  termoGarantiaId String
  termoGarantia  TermoGarantiaOS         @relation(fields: [termoGarantiaId], references: [id], onDelete: Cascade)
  osOrigemId     String?
  osOrigem       OrdemServico?            @relation("RetornoGarantiaOsOrigem", fields: [osOrigemId], references: [id], onDelete: SetNull)
  osRetornoId    String?                  @unique
  osRetorno      OrdemServico?            @relation("RetornoGarantiaDaOS")
  motivo         String
  descricao      String
  analiseTecnica String?
  resultado      ResultadoRetornoGarantia @default(EM_ANALISE)
  descricaoServico String?
  pecasAdicionais String?
  houveTroca     Boolean                  @default(false)
  houveCobranca  Boolean                  @default(false)
  valorAdicional Decimal? @db.Decimal(12, 2)
  observacoesTecnicas String?
  finalizadoEm   DateTime? @db.Timestamptz(3)
  finalizadoPorId String?
  criadoPorId    String?
  criadoPor      Usuario?                 @relation("RetornoGarantiaCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm       DateTime                 @default(now()) @db.Timestamptz(3)
  atualizadoEm   DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([termoGarantiaId])
  @@index([osOrigemId])
  @@index([osRetornoId])
  @@index([criadoEm])
  @@index([finalizadoEm])
}

enum ResultadoRetornoGarantia {
  PROCEDENTE
  IMPROCEDENTE
  SEM_GARANTIA
  RESOLVIDO_SEM_TROCA
  TROCA_REALIZADA
  COBRANCA_ADICIONAL
  EM_ANALISE
}

model ItemOS {
  id           String       @id @default(uuid())
  osId         String
  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  descricao    String
  tipoPeca     TipoPeca

  /**
   * Marca da peca. Obrigatoria NA APLICACAO para todo tipo menos OUTROS — e por
   * OUTROS que mao de obra e servico sao lancados, e servico nao tem marca.
   * Opcional na coluna porque os itens lancados antes deste cadastro existem e
   * nao tem marca: expand/contract, mesma decisao de OrdemServico.criadoPorId.
   * No relatorio eles aparecem agrupados como "sem marca", nunca diluidos nas
   * medias das marcas reais.
   */
  marcaPecaId  String?
  marcaPeca    MarcaPeca?   @relation(fields: [marcaPecaId], references: [id], onDelete: Restrict)

  custoPeca    Decimal      @db.Decimal(12, 2)
  valorCobrado Decimal      @db.Decimal(12, 2)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)

  @@index([marcaPecaId])
}

/**
 * Marcas de peca cadastradas pela loja (Fase 4).
 *
 * Peca de conserto nao e item de estoque neste negocio: e comprada para o
 * servico, sem entrada por nota, e por isso nao tem saldo nem movimentacao — e
 * custo direto da OS. O que o relatorio de custo e margem precisa, entao, nao e
 * vinculo com o catalogo de produtos, e vocabulario controlado: `ItemOS.tipoPeca`
 * (enum) cruzado com a marca escolhida aqui. Sem isso, `ItemOS.descricao` em
 * texto livre viraria "Tela iPhone 11", "tela ip 11" e "Tela IP11" como tres
 * pecas distintas, e nenhuma agregacao por peca teria resposta.
 *
 * Marca nunca e apagada quando ja foi usada (onDelete: Restrict acima) — se
 * saiu de linha, e desativada: `ativa = false` tira do seletor da OS e mantem o
 * historico intacto.
 */
model MarcaPeca {
  id   String @id @default(uuid())
  nome String

  /**
   * `nome` em minusculas, sem acento e sem espaco duplicado. E a unicidade real:
   * impede que "Original", "original" e "ORIGINAL " coexistam e quebrem o
   * agrupamento do relatorio. Derivado sempre em lib/dominio/os/marcas-peca.ts,
   * nunca montado na action.
   */
  nomeNormalizado String @unique

  ativa Boolean @default(true)

  itens ItemOS[]

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([ativa])
}

enum StatusOS {
  AGUARDANDO_ORCAMENTO
  AGUARDANDO_APROVACAO
  APROVADO
  AGUARDANDO_PECA
  EM_MANUTENCAO
  GARANTIA_RETORNO
  PRONTO
  ENTREGUE
}

/**
 * Fase 1C-3: as quatro etapas do fluxo de OS, substituindo os oito valores de
 * StatusOS como fonte de leitura da aplicacao. `status` continua sendo
 * escrito (escrita dupla) ate a fase de contrato remover a coluna — ver
 * docs/operacao/migrations.md e lib/dominio/os/etapas.ts.
 */
enum EtapaOS {
  ORCAMENTO
  CONSERTO
  PRONTO
  ENTREGUE
}

/** Situacao independente da etapa — nunca implica mudanca de etapa por si so. */
enum SituacaoOS {
  AGUARDANDO_APROVACAO
  AGUARDANDO_PECA
}

enum TipoPeca {
  TELA
  BATERIA
  CONECTOR_CARGA
  TAMPA_IPHONE
  TAMPA_ANDROID
  OUTROS
}

// ==========================================
// MÓDULO: FINANCEIRO (Contas a Receber)
// ==========================================
model ContaReceber {
  id        String @id @default(uuid())
  descricao String @default("")
  valor     Decimal @db.Decimal(12, 2)
  observacaoLancamento String?
  observacaoPagamento  String?

  parcelamentoId String?
  numeroParcela  Int     @default(1)
  totalParcelas  Int     @default(1)

  dataInicio      DateTime?
  dataFinalizacao DateTime? @db.Timestamptz(3)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  pedidoId String?
  pedido   PedidoVenda? @relation(fields: [pedidoId], references: [id])

  ordemServicoId String?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id])

  vendaId String?
  venda   Venda?  @relation(fields: [vendaId], references: [id])

  vendaPagamentoId String? @unique
  vendaPagamento   VendaPagamento? @relation(fields: [vendaPagamentoId], references: [id])

  dataVencimento  DateTime
  dataRecebimento DateTime? @db.Timestamptz(3)

  /**
   * Fase 2A-3 (regra de estorno): quando a venda e estornada, a conta e
   * MARCADA, nao apagada. O `cancelarPedido` antigo fazia `deleteMany` e
   * nao sobrava rastro nenhum de que a venda existiu e foi cancelada.
   */
  estornadaEm DateTime? @db.Timestamptz(3)

  status           StatusPagamento @default(PENDENTE)
  formaPagamento   FormaPagamento?
  formaRecebimento FormaPagamento
  /// Nota do Bling que originou esta conta, quando a conta nasceu de uma
  /// parcela de nota. Unico por parcela e o que torna a sincronizacao
  /// idempotente: reler a mesma nota nao cria a conta de novo.
  blingParcelaRef String? @unique

  origem           OrigemReceita

  notaFiscalEmitida Boolean @default(false)

  /** Quem lancou a conta — fonte de "financeiro.ver" sem "_todos" (Fase 1D-2, ver lib/auth/escopos.ts). Nulo em lancamentos antigos, sem backfill. */
  criadoPorId String?
  criadoPor   Usuario? @relation("ContaReceberCriadaPor", fields: [criadoPorId], references: [id])

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([parcelamentoId])
  @@index([pedidoId])
  @@index([vendaId])
  @@index([criadoPorId])
}

enum StatusPagamento {
  PENDENTE
  PAGO
  RECEBIDO
  ATRASADO
  RENEGOCIADO
  // Fase 2A-3: conta de venda estornada. Nao e pendente nem recebida — nao
  // entra em nenhum dos dois totais, e continua existindo pra consulta.
  ESTORNADO
}

enum FormaPagamento {
  PIX
  TED
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_CREDITO_AVISTA
  CARTAO_CREDITO_PARCELADO
  CARTAO_DEBITO
  BOLETO
  CREDIARIO
  EMPENHO_PUBLICO
  /// A forma ainda nao e conhecida.
  ///
  /// Existe por causa da conta que nasce de uma parcela de nota do Bling: a
  /// nota traz um id de forma de pagamento do Bling, que nao corresponde a
  /// nenhum valor deste enum. Gravar um chute — "PIX", como outros pontos
  /// deste sistema fazem quando nao sabem — poria forma de pagamento falsa
  /// num registro financeiro, e ela apareceria no grafico de entradas por
  /// forma como se fosse fato.
  NAO_INFORMADO
}

enum OrigemReceita {
  VENDA_PDV
  ORDEM_SERVICO
  CONTRATO_RECORRENTE
  LICITACAO
  AVULSO
  /// Parcela de nota emitida no Bling que NAO corresponde a nenhuma venda
  /// deste sistema. Nota que corresponde nao vira conta: ela e vinculada a
  /// venda que ja existe, senao o total a receber contaria duas vezes.
  BLING
}

// ==========================================
// MÓDULO: CONTAS A PAGAR
// ==========================================
model Despesa {
  id           String      @id @default(uuid())
  fornecedor   String
  descricao    String
  valorTotal   Decimal     @db.Decimal(12, 2)
  tipo         TipoDespesa
  /// Quantas parcelas o parcelamento tem. Em `FIXA_MENSAL` NAO significa
  /// nada: despesa fixa nao termina por contagem de parcela — ela segue ate
  /// ganhar `encerradaEm`. O campo continua existindo porque PARCELADA
  /// depende dele, e em FIXA_MENSAL guarda apenas o tamanho do horizonte
  /// materializado na criacao. Ver lib/dominio/financeiro/despesa-fixa.ts.
  qtdParcelas  Int

  /// Preenchido = o dono encerrou esta despesa fixa; nenhuma parcela nova e
  /// gerada a partir daqui, e as que ja venceram continuam onde estao.
  /// Sempre nulo em UNICA e PARCELADA, que terminam sozinhas.
  encerradaEm DateTime? @db.Timestamptz(3)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  /** Quem lancou a despesa — mesma regra de visibilidade de ContaReceber (Fase 1D-2). Nulo em despesas antigas, sem backfill. */
  criadoPorId String?
  criadoPor   Usuario? @relation("DespesaCriadaPor", fields: [criadoPorId], references: [id])

  criadoEm     DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime    @updatedAt @db.Timestamptz(3)

  parcelas ParcelaDespesa[]

  @@index([criadoPorId])
}

model ParcelaDespesa {
  id             String               @id @default(uuid())
  despesaId      String
  despesa        Despesa              @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  numeroParcela  Int
  valor          Decimal              @db.Decimal(12, 2)
  dataVencimento DateTime
  dataPagamento  DateTime? @db.Timestamptz(3)
  status         StatusParcelaDespesa @default(PENDENTE)
  valorPago      Decimal?             @db.Decimal(12, 2)
  criadoEm       DateTime             @default(now()) @db.Timestamptz(3)
}

enum TipoDespesa {
  UNICA
  PARCELADA
  FIXA_MENSAL
}

enum StatusParcelaDespesa {
  PENDENTE
  PAGO
  ATRASADO
}

// ==========================================
// MÓDULO: NOTAS FISCAIS
// ==========================================
/// Nota fiscal de SAIDA.
///
/// Pode ter sido lancada a mao (como era antes) ou ter vindo do Bling, onde
/// o dono emite. A presenca de `blingId` e o que distingue as duas: linha com
/// blingId e espelho de algo que existe la, e a sincronizacao pode atualiza-la;
/// linha sem blingId e do dono e a sincronizacao nunca toca nela.
model NotaFiscal {
  id          String           @id @default(uuid())
  numero      String
  serie       String?
  chaveAcesso String?
  /// NULO = ainda nao lido. A listagem do Bling NAO traz o valor; ele vem no
  /// detalhe, uma requisicao por nota. Gravar zero enquanto nao se sabe seria
  /// mentir no campo onde mentir e mais caro — o total da tela somaria errado
  /// e ninguem desconfiaria de um zero.
  valorTotal  Decimal?         @db.Decimal(12, 2)
  status      StatusNotaFiscal @default(PENDENTE)

  /// Id da nota no Bling, como TEXTO. Unico: e por ele que a sincronizacao
  /// reconhece a nota e atualiza em vez de duplicar.
  blingId     String?          @unique
  /// Codigo cru de situacao do Bling (1 a 11). `status` agrupa os onze em
  /// tres; este campo guarda a precisao, pra tela poder dizer "Rejeitada".
  situacaoBling Int?
  dataEmissao DateTime?        @db.Timestamptz(3)

  /// Nome e documento como vieram do Bling. Guardados crus porque o contato
  /// do Bling pode nao existir no cadastro de clientes da Konext — e uma nota
  /// sem nome na tela e pior que uma nota com o nome que o Bling conhece.
  clienteNome      String?
  clienteDocumento String?

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  /// A venda deste sistema que esta nota documenta, quando foi possivel
  /// reconhece-la. Nulo nao e defeito: o Bling nao manda referencia nenhuma
  /// ao Konext, entao o reconhecimento e por semelhanca (mesmo documento,
  /// mesmo valor, data proxima) e recusa o ambiguo de proposito. Ver
  /// lib/dominio/bling/casamento-de-venda.ts.
  pedidoId String?
  pedido   PedidoVenda? @relation(fields: [pedidoId], references: [id])

  /// Por que nao foi vinculada, para a tela explicar em vez de so omitir.
  motivoSemVinculo String?

  /// Endereco do XML e da DANFE no Bling. Sao o que permite baixar a nota
  /// sem sair do Konext. Guardados so quando apontam para o dominio do
  /// Bling — ver `linkDoBling`.
  linkXml   String?
  linkDanfe String?

  /// O que foi vendido, como o Bling descreve. Para a lista dizer algo alem
  /// de um numero.
  descricaoItens String?

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([dataEmissao])
  @@index([pedidoId])
}

enum StatusNotaFiscal {
  EMITIDA
  CANCELADA
  PENDENTE
}

// ==========================================
// MÓDULO: ESTOQUE E PRODUTOS
// ==========================================
/// Categoria de produto, cadastrada pelo dono.
///
/// Antes eram cinco valores fixos no enum `CategoriaProdutoLegado` (hoje
/// renomeado e a caminho da remoção). Nada no sistema se comportava diferente
/// por causa deles: serviam só de rótulo na tela e de filtro na lista — ou
/// seja, eram um cadastro travado em código por acidente, e "Capas" exigia
/// migration e deploy.
///
/// Mesmo formato de `MarcaPeca`: nome como o dono escreve, `nomeNormalizado`
/// como unicidade real (ver lib/dominio/texto/chave-de-nome.ts).
model CategoriaProduto {
  id   String @id @default(uuid())
  nome String

  /// `nome` em minúsculas, sem acento e sem espaço duplicado. Impede que
  /// "Capas", "capas" e "CAPAS " coexistam e quebrem o filtro da lista.
  nomeNormalizado String @unique

  ativa Boolean @default(true)

  produtos Produto[]

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([ativa])
}

model Produto {
  id           String  @id @default(uuid())
  codigoBarras String? @unique
  imagemUrl    String?
  nome         String
  descricao    String?

  /// Código curto do produto, `PREFIXO-0000` (ver lib/dominio/estoque/sku.ts).
  /// Gerado pelo sistema e editável: quem já tem código próprio não deve ser
  /// forçado a trocar. Anulável só por causa do histórico — produto cadastrado
  /// antes desta coluna não tinha SKU, e inventar um na migration criaria
  /// código que nunca foi impresso em etiqueta nenhuma.
  sku String? @unique

  /// Unidade de medida (UN, CX, PCT...). Lista fixa em
  /// lib/dominio/estoque/preco.ts: unidade de medida é padrão de mercado, não
  /// cadastro do dono.
  unidade String @default("UN")

  /// "iPhone 13 / 13 Pro" — para que serve ou com o que combina. O campo
  /// `descricao` existia e virava depósito de tudo; compatibilidade é o que a
  /// pessoa no balcão realmente procura.
  compatibilidade String?

  /// Exceção por produto à regra de estoque: permite fechar venda com saldo
  /// zerado mesmo com a configuração global do PDV desligada. Serve pro item
  /// que a loja encomenda sob demanda.
  permiteVendaSemEstoque Boolean @default(false)

  /// Mantida anulável e sem uso novo: é a coluna do enum antigo, preenchida só
  /// nos produtos que existiam antes da troca, e será removida numa migration
  /// de limpeza. A categoria de verdade é `categoriaId`.
  categoria CategoriaProdutoLegado?

  categoriaId String
  categoriaDoProduto CategoriaProduto @relation(fields: [categoriaId], references: [id])

  itensVenda ItemVenda[]
  pedidoVendaItens PedidoVendaItem[]

  custo      Decimal @db.Decimal(12, 2) // Preço de compra do fornecedor
  precoVenda Decimal @db.Decimal(12, 2) // Preço final para o cliente

  quantidadeEstoque Int @default(0)
  estoqueMinimo     Int @default(3) // Alerta quando estiver acabando

  movimentacoes MovimentacaoEstoque[]

  /// Em quais notas de compra este produto já entrou — o histórico de quanto
  /// ele custou, de qual fornecedor e em que data.
  itensDeNota NotaDeCompraItem[]

  ativo Boolean @default(true)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  /// O filtro da lista de estoque e os chips do PDV filtram por categoria.
  /// O Prisma não cria índice de chave estrangeira sozinho no PostgreSQL —
  /// sem esta linha, o `migrate diff` do CI pede a remoção do índice que a
  /// migration cria (foi o que aconteceu).
  @@index([categoriaId])
}

/**
 * Livro de movimentacoes de estoque (Fase 4).
 *
 * Antes disto, `Produto.quantidadeEstoque` era um numero mutado em quatro
 * lugares (venda do PDV, aprovacao de pedido, estorno de venda e edicao
 * manual) sem registrar NADA. O sistema sabia quanto tinha agora e nada sobre
 * como chegou ali: nao dava pra responder "o que entrou este mes", "esse
 * produto gira?" nem "quem mudou esse saldo". Relatorio de estoque sem livro
 * de movimentacao e chute.
 *
 * `quantidade` e SEMPRE positiva; o sinal vem de `tipo`. Guardar negativo em
 * SAIDA faria toda soma precisar lembrar da convencao.
 */
model MovimentacaoEstoque {
  id        String  @id @default(uuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  tipo   TipoMovimentacaoEstoque
  origem OrigemMovimentacaoEstoque

  /** Sempre positiva. O sinal vem de `tipo`. */
  quantidade Int

  /**
   * Saldo antes e depois do movimento. Guardados de proposito, mesmo sendo
   * derivaveis: e o que permite conferir a continuidade do livro (o
   * `saldoPosterior` de uma linha tem que ser o `saldoAnterior` da seguinte) e
   * flagrar divergencia entre o livro e `Produto.quantidadeEstoque`.
   *
   * NULO nas linhas reconstruidas do historico de vendas no backfill: o saldo
   * daquela epoca nunca foi registrado, e inventar um numero seria pior do que
   * admitir que nao se sabe.
   */
  saldoAnterior  Int?
  saldoPosterior Int?

  /** Custo unitario no momento do movimento, pra apuracao e curva ABC. */
  custoUnitario Decimal? @db.Decimal(12, 2)

  /** Venda que originou o movimento, quando houver. */
  vendaId String?

  /**
   * Nota de compra que originou a entrada, quando houver.
   *
   * Fecha o circuito da auditoria pro outro lado: de uma linha do livro de
   * estoque da pra chegar no documento do fornecedor que a produziu, com
   * data, valor e o frete que foi rateado — e nao so num texto solto em
   * `observacao`.
   */
  notaDeCompraId String?
  notaDeCompra   NotaDeCompra? @relation(fields: [notaDeCompraId], references: [id], onDelete: SetNull)

  observacao String?

  registradoPorId String?

  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([produtoId, criadoEm])
  @@index([criadoEm])
  @@index([origem])
  @@index([vendaId])
  @@index([notaDeCompraId])
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
}

enum OrigemMovimentacaoEstoque {
  /** Venda fechada no balcao (PDV). */
  VENDA_PDV
  /** Pedido de venda aprovado. */
  PEDIDO_VENDA
  /** Estorno de venda: devolve a peca ao estoque. */
  ESTORNO_VENDA
  /** Saldo informado no cadastro do produto. */
  CADASTRO
  /** Saldo corrigido a mao na tela de estoque. */
  AJUSTE_MANUAL
  /** Entrada por nota de compra do fornecedor — XML da NF-e ou PDF lido. */
  COMPRA_NOTA
  /** Contagem de inventario. */
  INVENTARIO
  /** Linha reconstruida do historico de vendas no backfill. */
  HISTORICO_RECONSTRUIDO
}

// ==========================================
// MÓDULO: CONTAS UNIFICADAS (Receber e Pagar)
// ==========================================
enum TipoCliente {
  CLIENTE_FINAL
  EMPRESA
  ORGAO_PUBLICO
}

model Conta {
  id          String   @id @default(cuid())
  descricao   String
  valor       Decimal  @db.Decimal(12, 2)
  vencimento  DateTime
  status      String   // PAGO, PENDENTE, ATRASADO
  tipo        String   // RECEBER ou PAGAR
  
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  
  criadoEm    DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)
}

/// Enum antigo de categoria de produto, a caminho da remoção.
///
/// Foi renomeado (era `CategoriaProduto`) para liberar o nome pra tabela
/// `CategoriaProduto`, que é onde as categorias passaram a viver — no Postgres
/// uma tabela e um tipo não podem ter o mesmo nome. Continua declarado só
/// porque `Produto.categoria` ainda existe, preenchido nos produtos anteriores
/// à troca; a migration de limpeza remove a coluna e este tipo junto.
enum CategoriaProdutoLegado {
  ACESSORIO
  PECA_REPARO
  EQUIPAMENTO_REDE
  SERVICO
  OUTROS
}

// ==========================================
// MÓDULO: VENDAS (PDV)
// ==========================================
enum StatusPedido {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

enum OrigemPedido {
  VENDAS
  PDV
}

model PedidoVenda {
  id String @id @default(uuid())

  /// Notas emitidas no Bling reconhecidas como este pedido.
  notasFiscais NotaFiscal[]

  numeroPedido Int @unique @default(autoincrement())
  status       StatusPedido @default(PENDENTE)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  vendaId String? @unique
  venda   Venda?  @relation(fields: [vendaId], references: [id])

  vendedor       String
  total          Decimal         @db.Decimal(12, 2)
  origem         OrigemPedido    @default(VENDAS)
  formaPagamento FormaPagamento?
  dataCriacao    DateTime @default(now()) @db.Timestamptz(3)

  itens         PedidoVendaItem[]
  parcelas      PedidoVendaParcela[]
  contasReceber ContaReceber[]

  @@index([clienteId])
  @@index([status])
  @@index([origem])
  @@index([dataCriacao])
}

model PedidoVendaItem {
  id String @id @default(uuid())

  pedidoId String
  pedido   PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  nome                 String
  quantidade           Int
  precoUnitario        Decimal @db.Decimal(12, 2)
  descontoPorcentagem  Decimal @default(0) @db.Decimal(7, 4)
  subtotal             Decimal @db.Decimal(12, 2)

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([pedidoId])
  @@index([produtoId])
}

model PedidoVendaParcela {
  id String @id @default(uuid())

  pedidoId String
  pedido   PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  valor          Decimal  @db.Decimal(12, 2)
  dataVencimento DateTime

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([pedidoId])
  @@index([dataVencimento])
}

model Venda {
  id        String   @id @default(uuid())
  clienteId String? // Opcional para venda rápida de balcão
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  itens ItemVenda[]
  pagamentos VendaPagamento[]
  pedidoVenda PedidoVenda?

  // Ligacao com o financeiro (suporta multiplas contas por venda)
  contasReceber ContaReceber[]

  formaPagamento FormaPagamento
  valorTotal     Decimal        @db.Decimal(12, 2)
  desconto       Decimal        @default(0) @db.Decimal(12, 2)

  // Fase 2A-2 cont. (item 2b — envio duplicado de venda): chave gerada pelo
  // cliente (crypto.randomUUID()) por TENTATIVA de venda, reenviada em
  // qualquer reenvio da MESMA tentativa (mesmo carrinho/modal ainda aberto).
  // Opcional e única — NULL para vendas antigas e qualquer chamador que não
  // a envie; Postgres permite múltiplos NULL numa coluna UNIQUE. Ver
  // lib/dominio/pdv/idempotencia-venda.ts e app/actions/pdv.ts.
  chaveIdempotencia String? @unique

  /**
   * Fase 2A-3 (regra de estorno). A venda NUNCA sai de `caixaSessionId`: o
   * esperado de fechamento daquela sessao e recalculado ao vivo a partir
   * das vendas dela, e mexer nisso mudaria, dias depois, a diferenca de
   * fechamento que alguem ja conferiu e assinou. O estorno e um movimento
   * separado, que cai em `estornoCaixaSession` — a sessao aberta no momento
   * do estorno, que e de onde o dinheiro de fato sai da gaveta.
   *
   * `estornadaEm` tambem e o que tira a venda da apuracao de receita:
   * gaveta e apuracao sao duas contas diferentes, e tratar as duas junto foi
   * o que deixou o cancelamento apagando conta a receber.
   */
  estornadaEm DateTime? @db.Timestamptz(3)

  estornoCaixaSession   CaixaSession? @relation("VendasEstornadasNaSessao", fields: [estornoCaixaSessionId], references: [id])
  estornoCaixaSessionId String?

  criadoEm       DateTime      @default(now()) @db.Timestamptz(3)
  caixaSession   CaixaSession? @relation(fields: [caixaSessionId], references: [id])
  caixaSessionId String?

  @@index([estornadaEm])
  @@index([estornoCaixaSessionId])
}

model VendaPagamento {
  id             String         @id @default(uuid())
  vendaId        String
  venda          Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  formaPagamento FormaPagamento
  valorBruto     Decimal        @db.Decimal(12, 2)
  percentualTaxa Decimal        @default(0) @db.Decimal(7, 4)
  valorTaxa      Decimal        @default(0) @db.Decimal(12, 2)
  valorLiquido   Decimal        @db.Decimal(12, 2)
  parcelas       Int            @default(1)
  diasVencimento Int?
  dataVencimento DateTime?

  contaReceber   ContaReceber?

  criadoEm       DateTime       @default(now()) @db.Timestamptz(3)
  atualizadoEm   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([vendaId])
  @@index([formaPagamento])
  @@index([dataVencimento])
  @@index([criadoEm])
}

model ItemVenda {
  id      String @id @default(uuid())
  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  descricao String @default("")

  quantidade    Int
  custoUnitario Decimal @default(0) @db.Decimal(12, 2)
  precoUnitario Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)
}

// ==========================================
// MÓDULO: CONTROLE DE FLUXO DE CAIXA
// ==========================================
model CaixaSession {
  id String @id @default(uuid())

  status CaixaStatus @default(ABERTO)

  valorAbertura   Decimal  @db.Decimal(12, 2) // Saldo inicial/troco
  valorFechamento Decimal? @db.Decimal(12, 2) // Saldo final conferido

  dataAbertura   DateTime  @default(now()) @db.Timestamptz(3)
  dataFechamento DateTime? @db.Timestamptz(3)

  vendas Venda[] // Vincula as vendas feitas nesta sessão

  /** Vendas de OUTRAS sessoes cujo estorno caiu nesta — ver Venda.estornoCaixaSessionId. */
  vendasEstornadasAqui Venda[] @relation("VendasEstornadasNaSessao")

  /** Quem abriu o caixa — fonte de "caixa.ver" sem "_todos" (Fase 1D-2, ver lib/auth/escopos.ts). Nulo em sessoes antigas, sem backfill. */
  abertoPorId String?
  abertoPor   Usuario? @relation("CaixaSessionAbertaPor", fields: [abertoPorId], references: [id])

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([abertoPorId])
}

enum CaixaStatus {
  ABERTO
  FECHADO
}

// ==========================================
// MÓDULO: NOTIFICAÇÕES
// ==========================================
model Notificacao {
  id       String @id @default(cuid())
  titulo   String
  mensagem String
  lida     Boolean  @default(false)
  criadoEm DateTime @default(now()) @db.Timestamptz(3)
}

// ==========================================
// MÓDULO: METAS
// ==========================================
model Meta {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String?
  categoria   CategoriaMeta
  tipoValor   TipoValorMeta
  origemProgresso OrigemProgressoMeta @default(MANUAL)
  fonteAutomatica FonteAutomaticaMeta?
  metricaAutomatica MetricaAutomaticaMeta?
  configuracaoAutomatica Json?
  direcao     DirecaoMeta   @default(MAIOR_MELHOR)
  // Fase 2A-3: Decimal(14,4), nao Float. A coluna e polimorfica — pode ser
  // dinheiro, quantidade ou percentual, conforme `tipoValor` em tempo de
  // execucao — e foi por isso que a Fase 2A-2 a deixou de fora. A escala 4
  // atende os tres: 2 casas bastam pra dinheiro, 4 e a convencao de
  // percentual do projeto (Decimal(7,4)), e quantidade quase sempre e
  // inteira. 10 digitos inteiros cobrem meta de dez bilhoes.
  valorAlvo   Decimal?       @db.Decimal(14, 4)
  valorAtual  Decimal        @default(0) @db.Decimal(14, 4)
  unidade     String?
  dataInicio  DateTime?
  dataPrazo   DateTime?
  ultimaSincronizacaoEm DateTime? @db.Timestamptz(3)
  erroSincronizacao String?
  prioridade  PrioridadeMeta @default(MEDIA)
  status      StatusMeta     @default(EM_ANDAMENTO)

  criadoPorId String?
  criadoPor   Usuario?       @relation("MetasCriadasPor", fields: [criadoPorId], references: [id])

  excluidaEm    DateTime? @db.Timestamptz(3)
  excluidaPorId String?
  concluidaEm   DateTime? @db.Timestamptz(3)
  canceladaEm   DateTime? @db.Timestamptz(3)

  itensChecklist ItemChecklistMeta[]
  historicos     HistoricoMeta[]

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([categoria])
  @@index([prioridade])
  @@index([dataPrazo])
  @@index([criadoEm])
  @@index([excluidaEm])
  @@index([origemProgresso])
  @@index([fonteAutomatica])
  @@index([metricaAutomatica])
  @@index([ultimaSincronizacaoEm])
}

model ItemChecklistMeta {
  id      String @id @default(uuid())
  metaId  String
  meta    Meta   @relation(fields: [metaId], references: [id], onDelete: Cascade)
  titulo  String
  concluido    Boolean  @default(false)
  ordem        Int      @default(0)
  concluidoEm  DateTime? @db.Timestamptz(3)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([metaId])
}

model HistoricoMeta {
  id             String            @id @default(uuid())
  metaId         String
  meta           Meta              @relation(fields: [metaId], references: [id], onDelete: Cascade)
  tipo           TipoHistoricoMeta
  descricao      String
  // Mesma escala de Meta.valorAlvo/valorAtual: o historico guarda os dois
  // lados da mudanca desses mesmos campos.
  valorAnterior  Decimal?          @db.Decimal(14, 4)
  valorNovo      Decimal?          @db.Decimal(14, 4)
  criadoPorId    String?
  criadoEm       DateTime          @default(now()) @db.Timestamptz(3)

  @@index([metaId])
  @@index([tipo])
  @@index([criadoEm])
}

enum CategoriaMeta {
  FINANCEIRA
  OPERACIONAL
  COMERCIAL
  ESTOQUE
  ESTRUTURAL
  EQUIPAMENTO
  REFORMA
  OUTRA
}

enum TipoValorMeta {
  DINHEIRO
  QUANTIDADE
  PERCENTUAL
  CHECKLIST
}

enum OrigemProgressoMeta {
  MANUAL
  AUTOMATICA
}

enum DirecaoMeta {
  MAIOR_MELHOR
  MENOR_MELHOR
}

enum FonteAutomaticaMeta {
  ORDENS_SERVICO
  FINANCEIRO
  PDV
  VENDAS
  ESTOQUE
  GARANTIAS
}

enum MetricaAutomaticaMeta {
  FATURAMENTO_OS
  QUANTIDADE_OS_FINALIZADAS
  QUANTIDADE_OS_CRIADAS
  TICKET_MEDIO_OS
  TAXA_RETORNO_GARANTIA
  GARANTIAS_ATIVAS
  RETORNOS_GARANTIA
  FATURAMENTO_PDV
  QUANTIDADE_VENDAS
  RECEBIMENTOS_FINANCEIRO
  DESPESAS_FINANCEIRO
  QUANTIDADE_ITEM_ESTOQUE
}

enum PrioridadeMeta {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusMeta {
  EM_ANDAMENTO
  ATENCAO
  ATRASADA
  CONCLUIDA
  PAUSADA
  CANCELADA
}

enum TipoHistoricoMeta {
  CRIACAO
  ATUALIZACAO_PROGRESSO
  ALTERACAO_STATUS
  ALTERACAO_PRAZO
  ALTERACAO_CHECKLIST
  SINCRONIZACAO_AUTOMATICA
  CONCLUSAO
  PAUSA
  CANCELAMENTO
  OBSERVACAO
}

/// Momento do fluxo em que a foto foi tirada.
///
/// Entrada e saída não são a mesma prova: a de entrada protege a loja do "vocês
/// quebraram minha tela", a de saída registra como o aparelho foi devolvido.
/// Guardar as duas no mesmo balaio apagaria exatamente a distinção que faz a
/// foto valer alguma coisa numa discussão com o cliente.
enum MomentoFotoOS {
  ENTRADA
  DURANTE
  SAIDA
}

/// Foto de um aparelho, guardada no Cloudflare R2.
///
/// O arquivo NÃO fica no banco: aqui só mora o caminho dele no bucket. Imagem
/// em coluna de banco encarece backup, deixa a consulta lenta e não traz
/// vantagem nenhuma.
model FotoOS {
  id             String       @id @default(uuid())
  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  /// Caminho do objeto no bucket. É a ÚNICA ligação entre a linha e o arquivo:
  /// perder isto é perder a foto, mesmo com o arquivo intacto lá.
  ///
  /// O `onDelete: Cascade` acima apaga a linha junto com a OS, mas não apaga o
  /// objeto no R2 — exclusão de OS neste sistema é lógica (`excluidaEm`), então
  /// na prática isso não dispara; quem apaga foto de verdade é a action, que
  /// remove o objeto primeiro e a linha depois.
  chaveArmazenamento String @unique

  momento   MomentoFotoOS @default(ENTRADA)
  descricao String?

  tipoConteudo String
  tamanhoBytes Int
  /// Dimensões, quando o navegador conseguiu medir. Servem pra tela reservar o
  /// espaço antes de a imagem carregar, sem pular o layout.
  largura Int?
  altura  Int?

  enviadaPorId String?
  enviadaPor   Usuario? @relation("FotoOSEnviadaPor", fields: [enviadaPorId], references: [id])
  /// Veio pelo link do celular, sem login — por isso `enviadaPorId` pode ser nulo.
  enviadaPeloCelular Boolean @default(false)

  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([ordemServicoId, momento])
}

/// Link temporário para mandar foto pelo celular sem login.
///
/// É uma linha no banco, e não um token assinado, por dois motivos: dá pra
/// revogar antes do prazo, e o uso fica rastreável. O próprio id é o segredo
/// do link, então ele nunca aparece em lugar público.
model TokenFotoOS {
  id             String       @id @default(uuid())
  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  /**
   * SHA-256 do segredo do link, em hexadecimal.
   *
   * O segredo tem 32 bytes sorteados, vai pro link UMA vez e nunca é
   * gravado — mesmo desenho de senha e de sessão. Quem tem o link entra, e
   * um valor que dá acesso não pode ser o mesmo que o sistema usa pra se
   * referir à linha (o `id`), que aparece em log, em consulta e em
   * relatório. Perdeu o link, gera outro: não há como reconstruir.
   */
  tokenHash String @unique

  expiraEm   DateTime  @db.Timestamptz(3)
  revogadoEm DateTime? @db.Timestamptz(3)

  /// Última vez que o link foi aberto. Responde "mandei e não chegou foto —
  /// será que ele abriu?" sem precisar cruzar com a galeria.
  ultimoUsoEm DateTime? @db.Timestamptz(3)

  criadoPorId String?
  criadoPor   Usuario? @relation("TokenFotoOSCriadoPor", fields: [criadoPorId], references: [id])

  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([ordemServicoId])
  @@index([expiraEm])
}

// ==========================================
// MÓDULO: ENTRADA DE NOTA DE COMPRA
// ==========================================

/**
 * O documento do fornecedor que virou estoque.
 *
 * Gravado no momento do LANÇAMENTO, já conferido — não existe rascunho no
 * banco. A conferência inteira acontece na tela, e fechar a aba no meio
 * perde dois minutos de trabalho: é o preço de não ter máquina de estados,
 * status pela metade e nota meio-lançada.
 */
model NotaDeCompra {
  id     String               @id @default(uuid())
  origem OrigemDaNotaDeCompra

  /**
   * Os 44 dígitos da NF-e, e a trava de idempotência desta tela inteira.
   *
   * Único. É o que impede a mesma nota de entrar duas vezes no estoque — o
   * erro mais provável aqui, porque o jeito natural de usar um importador é
   * arrastar o arquivo de novo quando não se tem certeza se já foi. Anulável
   * porque orçamento e pedido de fornecedor não têm chave e nunca vão ter.
   */
  chaveAcesso String? @unique

  numero String?
  serie  String?

  emitenteNome String
  emitenteCnpj String?

  /// A data impressa no documento, não um instante — por isso `date`.
  emitidaEm DateTime? @db.Date

  valorProdutos Decimal @db.Decimal(12, 2)
  valorFrete    Decimal @default(0) @db.Decimal(12, 2)
  valorDesconto Decimal @default(0) @db.Decimal(12, 2)
  valorTotal    Decimal @db.Decimal(12, 2)

  /// Qual critério dividiu o frete entre os itens: muda o custo de cada um.
  criterioRateio CriterioDeRateioDeFrete @default(VALOR)

  arquivoNome String?
  observacao  String?

  itens         NotaDeCompraItem[]
  movimentacoes MovimentacaoEstoque[]

  lancadaPorId String?
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)

  @@index([criadoEm])
  @@index([emitenteNome])
}

model NotaDeCompraItem {
  id     String       @id @default(uuid())
  notaId String
  nota   NotaDeCompra @relation(fields: [notaId], references: [id], onDelete: Cascade)

  ordem Int

  /// Como estava escrito no documento, sem tratamento: é por onde a pessoa
  /// acha a linha de volta no papel.
  descricao        String
  codigoFornecedor String?
  ean              String?
  ncm              String?
  unidade          String?

  /// 4 casas na quantidade e no unitário porque o layout da NF-e usa 4 e 10;
  /// o TOTAL da linha é que tem 2 e é a verdade do documento.
  quantidade    Decimal @db.Decimal(12, 4)
  valorUnitario Decimal @db.Decimal(12, 4)
  valorTotal    Decimal @db.Decimal(12, 2)

  rateioFrete    Decimal @default(0) @db.Decimal(12, 2)
  rateioDesconto Decimal @default(0) @db.Decimal(12, 2)

  /// Linha + frete − desconto, por unidade: o que foi gravado em
  /// `Produto.custo`, guardado aqui pra poder conferir depois.
  custoUnitario Decimal @db.Decimal(12, 2)

  /**
   * NULO quando a linha foi IGNORADA na conferência.
   *
   * A linha ignorada fica gravada de propósito: "por que isso não entrou no
   * estoque?" precisa ter resposta, e a resposta é que foi lida e deixada de
   * fora — não que sumiu.
   */
  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  /// Se este item CRIOU o produto ou só somou saldo a um que já existia.
  criouProduto Boolean @default(false)

  @@index([notaId])
  @@index([produtoId])
}

enum OrigemDaNotaDeCompra {
  /// XML da NF-e: estruturado e assinado, sem inferência nenhuma.
  XML
  /// PDF do fornecedor: desenho interpretado, conferido pela aritmética.
  PDF
}

/**
 * Transportadora cobra por peso e volume, e a nota não traz nem um nem
 * outro. Não existe critério certo, existe o menos ruim pra carga.
 */
enum CriterioDeRateioDeFrete {
  /// O item mais caro absorve mais frete.
  VALOR
  /// Cada unidade carrega a mesma fatia.
  QUANTIDADE
}
