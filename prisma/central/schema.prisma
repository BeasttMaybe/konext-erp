generator client {
  provider   = "prisma-client-js"
  output     = "../../node_modules/@prisma/client-central"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum StatusEmpresa {
  ATIVA
  SUSPENSA
  INATIVA
}

enum StatusTenant {
  PROVISIONANDO
  ATIVO
  SUSPENSO
  ERRO
}

enum RoleEmpresa {
  ADMIN
  GESTOR
  USUARIO
}

model Empresa {
  id           String           @id @default(uuid())
  nome         String
  slug         String           @unique
  status       StatusEmpresa    @default(ATIVA)
  tenants      Tenant[]
  usuarios     UsuarioEmpresa[]
  cargos       Cargo[]
  logsAuditoria LogAuditoria[]
  chaveDeCifra ChaveDeCifraEmpresa?
  modulos      ModuloEmpresa[]
  /**
   * Conta responsavel pela loja (Fase 1D-3, protecao do dono) — a UsuarioEmpresa
   * que criou a empresa, com protecoes que nenhum outro admin tem (ver
   * lib/auth/invariantes-cargos.ts). NUNCA inferir "quem e o dono" por data de
   * criacao em nenhum outro lugar do codigo — este campo e a unica fonte.
   * So muda via transferirPropriedade (app/actions/usuarios.ts).
   */
  proprietarioUsuarioEmpresaId String?          @unique
  proprietario                 UsuarioEmpresa?  @relation("EmpresaProprietario", fields: [proprietarioUsuarioEmpresaId], references: [id])
  criadoEm     DateTime         @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime         @updatedAt @db.Timestamptz(3)
}

model Tenant {
  id            String       @id @default(uuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  slug          String       @unique
  status        StatusTenant @default(PROVISIONANDO)
  versaoSchema  String
  connectionRef String?
  criadoEm      DateTime     @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime     @updatedAt @db.Timestamptz(3)

  @@index([empresaId])
  @@index([status])
}

model UsuarioCentral {
  id           String           @id @default(uuid())
  nome         String
  email        String           @unique
  senha        String
  ativo        Boolean          @default(true)
  empresas     UsuarioEmpresa[]
  logsAuditoria LogAuditoria[]
  tokensDeRecuperacao TokenRecuperacaoSenha[]
  criadoEm     DateTime         @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime         @updatedAt @db.Timestamptz(3)
}

model SessaoCentral {
  id               String      @id @default(uuid())
  tokenHash        String      @unique
  usuarioCentralId String
  empresaId        String
  tenantId         String
  role             RoleEmpresa
  expiraEm         DateTime @db.Timestamptz(3)
  revogadaEm       DateTime? @db.Timestamptz(3)
  ultimoUsoEm      DateTime? @db.Timestamptz(3)
  criadoEm         DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm     DateTime    @updatedAt @db.Timestamptz(3)

  @@index([usuarioCentralId])
  @@index([empresaId])
  @@index([tenantId])
  @@index([expiraEm])
  @@index([revogadaEm])
}

model UsuarioEmpresa {
  id           String         @id @default(uuid())
  usuarioId    String
  usuario      UsuarioCentral @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId    String
  empresa      Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  // RoleEmpresa legado: mantido em escrita dupla enquanto Cargo nao substitui
  // por completo a autorizacao (Fase 1D-1) — ver lib/auth/mapear-cargo-legado.ts.
  role         RoleEmpresa    @default(USUARIO)
  cargoId      String?
  cargo        Cargo?         @relation(fields: [cargoId], references: [id])
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @db.Timestamptz(3)
  /** Lado inverso de Empresa.proprietario — presente so quando esta linha e a conta responsavel por alguma empresa. */
  empresaComoProprietario Empresa? @relation("EmpresaProprietario")

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@index([role])
  @@index([cargoId])
}

/**
 * Cargo configuravel por empresa (Fase 1D-1) — substitui gradualmente o
 * RoleEmpresa fixo de 3 valores. "Administrador" nasce com fixo=true em toda
 * empresa (ver backfill da migracao): suas permissoes nunca sao as linhas de
 * CargoPermissao, e sim o catalogo inteiro, sempre — ver
 * lib/auth/invariantes-cargos.ts.
 */
model Cargo {
  id           String           @id @default(uuid())
  empresaId    String
  empresa      Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome         String
  descricao    String?
  fixo         Boolean          @default(false)
  /** Soft delete — cargo em uso nao pode ser arquivado (ver invariantes). */
  arquivadoEm  DateTime? @db.Timestamptz(3)
  permissoes   CargoPermissao[]
  usuarios     UsuarioEmpresa[]
  criadoEm     DateTime         @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@index([arquivadoEm])
}

model CargoPermissao {
  id        String @id @default(uuid())
  cargoId   String
  cargo     Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  /** String, nao enum: o catalogo (lib/auth/permissoes.ts) e a fonte de verdade, nao o banco. */
  permissao String

  @@unique([cargoId, permissao])
  @@index([cargoId])
}

/**
 * Trilha de auditoria do banco CENTRAL — espelha o LogAuditoria do tenant
 * (prisma/schema.prisma), mas para mudancas que vivem so aqui: cargos,
 * permissoes e vinculos de usuario/empresa (Fase 1D-1). Mesmo nome de
 * modelo de proposito: reaproveita o contrato de lib/auditoria.ts (delegate
 * `logAuditoria`/`LogAuditoria`), so que apontado pro client central — ver
 * lib/auditoria-central.ts.
 */
model LogAuditoria {
  id          String          @id @default(uuid())
  empresaId   String
  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId   String?
  usuario     UsuarioCentral? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao        String
  entidade    String
  entidadeId  String?
  dadosAntes  Json?
  dadosDepois Json?
  motivo      String?
  origem      String?
  criadoEm    DateTime        @default(now()) @db.Timestamptz(3)

  @@index([empresaId])
  @@index([usuarioId])
  @@index([entidade])
  @@index([entidadeId])
  @@index([acao])
  @@index([criadoEm])
}

/**
 * Chave de cifra de cada loja (AES-256-GCM, 32 bytes em base64) para os dados
 * sensiveis que ficam no banco do TENANT — hoje, a senha e o desenho de
 * desbloqueio do aparelho na OS. Fica no banco CENTRAL de proposito: quem
 * obtiver uma copia do banco da loja nao tem a chave junto. Gerada na primeira
 * vez que a loja precisa dela (lib/seguranca/chave-da-empresa.ts) e nunca
 * trocada por codigo — trocar exige recifrar tudo antes.
 */
model ChaveDeCifraEmpresa {
  empresaId String   @id
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chave     String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
}

/**
 * Falha de login (e-mail ou senha errados), para o limite de tentativas —
 * regras em lib/auth/limite-login.ts. E-mail e IP so como hash SHA-256.
 * Linhas com mais de um dia sao apagadas aos poucos (lib/auth/tentativas-login.ts).
 */
model TentativaLoginFalha {
  id        String   @id @default(uuid())
  emailHash String
  ipHash    String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)

  @@index([emailHash, criadoEm])
  @@index([ipHash, criadoEm])
  @@index([criadoEm])
}

/**
 * Link de "esqueci minha senha": guarda so o hash do token (quem le o banco
 * nao consegue usar o link), vale por pouco tempo e uma vez so.
 */
model TokenRecuperacaoSenha {
  id         String         @id @default(uuid())
  usuarioId  String
  usuario    UsuarioCentral @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String         @unique
  expiraEm   DateTime       @db.Timestamptz(3)
  usadoEm    DateTime?      @db.Timestamptz(3)
  criadoEm   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([usuarioId, criadoEm])
}

/**
 * Erro do servidor capturado (instrumentation.ts -> onRequestError), para o
 * aviso automatico e a tela "Estado do sistema". Sem dado de cliente: so onde
 * aconteceu e a mensagem.
 */
model ErroDoSistema {
  id         String    @id @default(uuid())
  empresaId  String?
  origem     String
  mensagem   String
  digest     String?
  avisadoEm  DateTime? @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([criadoEm])
  @@index([empresaId, criadoEm])
}

/**
 * Modulo contratado por loja (lib/modulos/catalogo.ts). SEM LINHA = LIGADO:
 * toda loja nasce com tudo, e o sistema master grava aqui so o que mudar.
 */
model ModuloEmpresa {
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  modulo       String
  ativo        Boolean
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  @@id([empresaId, modulo])
}

/**
 * Quem administra o Konext pelo sistema master (pasta master/). Separado dos
 * usuarios das lojas de proposito: uma conta de loja nunca vira acesso ao
 * master, e vice-versa. O primeiro administrador so pode ser criado com o
 * codigo MASTER_CODIGO_DE_CRIACAO (variavel de ambiente do projeto master).
 */
model AdministradorMaster {
  id        String        @id @default(uuid())
  nome      String
  email     String        @unique
  senhaHash String
  ativo     Boolean       @default(true)
  criadoEm  DateTime      @default(now()) @db.Timestamptz(3)
  sessoes   SessaoMaster[]
  registros RegistroMaster[]
}

/** Sessao do master: o cookie leva o token; aqui fica so o hash dele. */
model SessaoMaster {
  id              String              @id @default(uuid())
  administradorId String
  administrador   AdministradorMaster @relation(fields: [administradorId], references: [id], onDelete: Cascade)
  tokenHash       String              @unique
  expiraEm        DateTime            @db.Timestamptz(3)
  revogadaEm      DateTime?           @db.Timestamptz(3)
  criadoEm        DateTime            @default(now()) @db.Timestamptz(3)

  @@index([administradorId])
}

/**
 * Tudo o que um administrador faz pelo master (ligar/desligar modulo,
 * suspender/reativar loja...): quem, o que, em qual loja e quando.
 */
model RegistroMaster {
  id              String              @id @default(uuid())
  administradorId String
  administrador   AdministradorMaster @relation(fields: [administradorId], references: [id], onDelete: Restrict)
  empresaId       String?
  acao            String
  detalhes        Json?
  criadoEm        DateTime            @default(now()) @db.Timestamptz(3)

  @@index([empresaId, criadoEm])
  @@index([criadoEm])
}
